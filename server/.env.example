# ── Server ────────────────────────────────────────────────────────────────
PORT=4000

# Comma-separated list of allowed browser origins (CORS).
CLIENT_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quickems

# ── Auth ──────────────────────────────────────────────────────────────────
# Use a long random string (32+ characters).
JWT_SECRET=replace-with-a-long-random-secret

# Used by the seed script and as the recipient of leave reminders.
ADMIN_EMAIL=admin@example.com

# ── Time ──────────────────────────────────────────────────────────────────
# IANA timezone used for attendance days, late detection, and cron jobs.
TIME_ZONE=Asia/Jakarta

# ── Email (optional: reminders and notifications) ─────────────────────────
SMTP_HOST=smtp.example.com
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SENDER_EMAIL=no-reply@example.com

# ── Inngest (optional: background jobs and cron) ──────────────────────────
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# For local development with the Inngest Dev Server, uncomment:
# INNGEST_DEV=1
